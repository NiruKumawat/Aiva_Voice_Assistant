# ==============================================================================
# Screen Voice AI Assistant Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# NEVER commit your actual '.env' file to Git!

# [REQUIRED] Groq API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# [OPTIONAL] AI Models
# STT_MODEL=whisper-large-v3-turbo
# AI_MODEL=qwen/qwen3.8-27b
# AI_TEXT_MODEL=qwen/qwen3.8-27b

# [OPTIONAL] Capture Mode: 'FULL_SCREEN' or 'ACTIVE_WINDOW'
CAPTURE_MODE=FULL_SCREEN

# [OPTIONAL] V2 Computer Control
# ENABLE_COMPUTER_CONTROL=true
# ENABLE_FAST_PATH=true
# ENABLE_ACTION_VERIFICATION=false
# REQUIRE_CONFIRMATION_FOR_SENSITIVE_ACTIONS=true
# EMERGENCY_STOP_KEY=esc
